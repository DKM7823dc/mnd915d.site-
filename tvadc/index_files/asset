		<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script nonce="tALwUmzi+LWHfhe2Pbbg9hupjlSuDLwikiH4aqIZEjw=">
            $(function () {
                $('#Criteria1').keydown(function (e) {
                    if (e.which == '13') {
                        $("#divnorecordsfound").hide();
                        $('#submit-button').click();
                    }
                });
                $('#Criteria2').keydown(function (e) {

                    if (e.which == '13') {
                        $("#divnorecordsfound").hide();
                        $('#submit-button').click();
                    }
                });

				var loginTypeSelector1 = $('#LoginType_1 select');
                var loginTypeSelector2 = $('#LoginType_2 select');
                var loginTypeSelectorOptions = loginTypeSelector1.children().clone(true, true);

				loginTypeSelector1.change(function () {
					var loginTypeSelector1Value = loginTypeSelector1.val();
                    var loginTypeSelector2Value = loginTypeSelector2.val();

					SetSecondDropdownOptionsAndSelectedValue(
                        loginTypeSelectorOptions,
                        loginTypeSelector1Value,
						loginTypeSelector2,
                        loginTypeSelector2Value);
                });

				loginTypeSelector2.change(function () {
					var loginTypeSelector1Value = loginTypeSelector1.val();
					var loginTypeSelector2Value = loginTypeSelector2.val();

                    SetSecondDropdownOptionsAndSelectedValue(
                        loginTypeSelectorOptions,
                        loginTypeSelector2Value,
                        loginTypeSelector1,
                        loginTypeSelector1Value);
                });

				loginTypeSelector1.change();
                loginTypeSelector2.change();
            });

            function SetSecondDropdownOptionsAndSelectedValue(
                loginTypeSelectorOptions,
                thisLoginTypeSelectorValue,
                secondLoginTypeSelector,
                secondLoginTypeSelectorValue) {

				var options = loginTypeSelectorOptions.clone(true, true);

				switch (Number(thisLoginTypeSelectorValue)) {
					case 3:
					case 4:
					case 5:
						options = options.not('option[value = 3]').not('option[value = 4]').not('option[value = 5]');
						break;
					default:
						options = options.not('option[value = ' + thisLoginTypeSelectorValue + ']');
				}

				secondLoginTypeSelector.empty().append(options);

				var secondLoginTypeSelectorSelectedOptionElement = secondLoginTypeSelector.find('option[value = ' + secondLoginTypeSelectorValue + ']');

				if (secondLoginTypeSelectorSelectedOptionElement.length) {
					secondLoginTypeSelectorSelectedOptionElement.attr('selected', true)
				}
				else {
					var value = thisLoginTypeSelectorValue == 0 ? 3 : 0;
					secondLoginTypeSelector.find('option[value = ' + value + ']').attr('selected', true)
				}
            }

            function OnLoginSuccess(data) {
                if (data.NoRecords == true) {
                    $("#divnorecordsfound").show();
                    hideLoadingButton($('#submit-button'), $('#loadingbtn'));
                    $("#loadingbtn").hide();
                }
                else if (data.RedirectUrl != null) {
                    window.location.href = data.RedirectUrl;
                }
                else {
                    //$("#divnorecordsfound").hide();
                    hideLoadingButton($('#submit-button'), $('#loadingbtn'));
                    $("#loadingbtn").hide();
                }

            }
            function OnLoginBegin(data) {
                $("#divnorecordsfound").hide();
                showLoadingButton($('#submit-button'), $('#loadingbtn'));
            }
