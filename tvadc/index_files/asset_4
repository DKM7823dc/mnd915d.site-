<script>
// main navigation function that pulls in dynamic content
function pg(query, hash) {
    if (/content=/.test(query)) { 
        $('#page').load('section.php?'+query);
    } else {
        $('#page').load(query);
    }
    if (hash != null && hash.length > 1) {
        setTimeout(function () { go(hash); }, 800);
    }
}
// animation to roll down past the header
function go(hash) {
	$(document).ready(function () {
		$("html, body").animate({ scrollTop: $(hash).offset().top }, 800);
	});
}
// this function sets up the link and title for loading pages in the background - e.g. news
function h(link, title) {
	var pattern = location.search.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	var tester = new RegExp(pattern, 'i');
	// if we haven't seen this link before push it into history if we can
	if (!tester.test(link) && typeof (history.pushState) != 'undefined') {
		shortlink = link.replace('section.php','')
		var obj = {Url: shortlink, Page: title};
		history.pushState(obj, obj.Page, obj.Url);
	}
	document.title = title;
}
// background load a page
function bg(link, title) {
	pg(link, '#top');
	h(link, title);
}
</script>

