<script>
// Map ?content= keys that have dedicated assets/pages/ files
var contentPageMap = {
    'howto': 'assets/pages/howto.php',
};

hash = ((location.hash.length > 1) ? location.hash: '#top');
if (/content=validate$/.test(location.search) && document.referrer.length > 0)  {
    search = location.search + "&ref=" + document.referrer;
    pg(search.substring(1), hash);
} else if (/content=index/.test(location.search)) {
    pg('assets/pages/default.php', location.hash);
} else if (location.search.length > 1) {
    var contentMatch = location.search.match(/[?&]content=([^&]+)/);
    if (contentMatch && contentPageMap[contentMatch[1]]) {
        pg(contentPageMap[contentMatch[1]], hash);
    } else if (/content=|assets\/pages\/(apply|awards).php/.test(location.search)) {
        pg(location.search.substring(1), hash);
    } else {
        pg('assets/pages/default.php', location.hash);
    }
} else {
    pg('assets/pages/default.php', location.hash);
}
</script>

